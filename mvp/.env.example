# Copy this file to .env and fill in your key (do NOT commit .env)

# Preferred for mainland China network: DeepSeek API (official 2026 model IDs: deepseek-flash / deepseek-v4-pro)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional: Generic OpenAI-compatible API (e.g. DashScope / SiliconFlow / OpenAI)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional: Local Ollama (zero API cost)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3:latest
